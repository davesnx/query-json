{"version": 2, "width": 140, "height": 48, "timestamp": 1773233403, "env": {"SHELL": "/usr/bin/zsh", "TERM": "xterm-256color"}}
[0.004673, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/00-error-messages.sh\r\n"]
[0.006121, "o", "\r\n# Helpful error messages\r\n"]
[0.807098, "o", "\r\n$ _opam/bin/query-json '.naem' '{\"name\":\"Alice\"}'\r\n"]
[0.812987, "o", "\r\n\u001b[31m\u001b[1merror\u001b[0m\u001b[0m\u001b[31m[key_not_found]\u001b[0m\u001b[31m:\u001b[0m Key 'naem' not found in object\r\n\r\n  \u001b[90min:\u001b[0m { \u001b[1m\u001b[34m\"name\"\u001b[39m\u001b[0m: \u001b[90m...\u001b[39m\u001b[0m }\r\n  \u001b[36mhint:\u001b[0m Use .naem? for optional access\r\n\r\n"]
[2.817104, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/01-stricter-null-handling.sh\r\n"]
[2.819589, "o", "\r\n# Stricter null handling\r\n"]
[3.620918, "o", "\r\n$ _opam/bin/query-json '.missing.key' '{\"name\":\"Alice\"}'\r\n"]
[3.626706, "o", "\r\n\u001b[31m\u001b[1merror\u001b[0m\u001b[0m\u001b[31m[key_not_found]\u001b[0m\u001b[31m:\u001b[0m Key 'missing' not found in object\r\n\r\n  \u001b[90min:\u001b[0m { \u001b[1m\u001b[34m\"name\"\u001b[39m\u001b[0m: \u001b[90m...\u001b[39m\u001b[0m }\r\n  \u001b[36mhint:\u001b[0m Use .missing? for optional access\r\n\r\n"]
[4.628853, "o", "\r\n$ _opam/bin/query-json '.missing?.key?' '{\"name\":\"Alice\"}'\r\n"]
[4.634381, "o", "\u001b[32mnull\u001b[39m\u001b[0m\r\n"]
[6.637514, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/02-fn-vs-def.sh\r\n"]
[6.639332, "o", "\r\n# fn vs def\r\n"]
[7.440324, "o", "\r\n$ echo '[1,2,3]' | jq 'def double: . * 2; map(double)'\r\n"]
[7.44242, "o", "\u001b[1;39m[\r\n  \u001b[0;39m2\u001b[0m\u001b[1;39m,\r\n  \u001b[0;39m4\u001b[0m\u001b[1;39m,\r\n  \u001b[0;39m6\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[8.443805, "o", "\r\n$ echo '[1,2,3]' | _opam/bin/query-json 'fn double: . * 2; map(double)'\r\n"]
[8.449792, "o", "[ \u001b[32m2\u001b[39m\u001b[0m, \u001b[32m4\u001b[39m\u001b[0m, \u001b[32m6\u001b[39m\u001b[0m ]\r\n"]
[10.453349, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/03-snake-case-naming.sh\r\n"]
[10.456766, "o", "\r\n# Snake case naming\r\n"]
[11.258237, "o", "\r\n$ echo '\"hello\"' | jq 'ascii_upcase'\r\n"]
[11.260548, "o", "\u001b[0;32m\"HELLO\"\u001b[0m\r\n"]
[12.262283, "o", "\r\n$ echo '\"hello\"' | _opam/bin/query-json 'to_uppercase'\r\n"]
[12.268596, "o", "\u001b[32m\"HELLO\"\u001b[39m\u001b[0m\r\n"]
[14.272562, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/04-clearer-naming.sh\r\n"]
[14.275116, "o", "\r\n# Clearer naming\r\n"]
[15.076378, "o", "\r\n$ echo '\"hello world\"' | jq 'startswith(\"hello\")'\r\n"]
[15.078633, "o", "\u001b[0;39mtrue\u001b[0m\r\n"]
[16.08008, "o", "\r\n$ echo '\"hello world\"' | _opam/bin/query-json 'starts_with(\"hello\")'\r\n"]
[16.085986, "o", "\u001b[32mtrue\u001b[39m\u001b[0m\r\n"]
[18.089668, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/05-group-by-behavior.sh\r\n"]
[18.092152, "o", "\r\n# group_by behavior\r\n"]
[18.8933, "o", "\r\n$ echo '[{\"x\":1},{\"x\":2},{\"x\":1}]' | jq 'group_by(.x)'\r\n"]
[18.895705, "o", "\u001b[1;39m[\r\n  \u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"x\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"x\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n"]
[18.895716, "o", "  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"x\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[19.897101, "o", "\r\n$ echo '[{\"x\":1},{\"x\":2},{\"x\":1}]' | _opam/bin/query-json 'group_by(.x)'\r\n"]
[19.90319, "o", "{ \u001b[1m\u001b[34m\"1\"\u001b[39m\u001b[0m: [ { \u001b[1m\u001b[34m\"x\"\u001b[39m\u001b[0m: \u001b[32m1\u001b[39m\u001b[0m }, { \u001b[1m\u001b[34m\"x\"\u001b[39m\u001b[0m: \u001b[32m1\u001b[39m\u001b[0m } ], \u001b[1m\u001b[34m\"2\"\u001b[39m\u001b[0m: [ { \u001b[1m\u001b[34m\"x\"\u001b[39m\u001b[0m: \u001b[32m2\u001b[39m\u001b[0m } ] }\r\n"]
[21.906969, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/06-keys-insertion-order.sh\r\n"]
[21.909075, "o", "\r\n# keys insertion order\r\n"]
[22.710285, "o", "\r\n$ echo '{\"z\":1,\"a\":2,\"m\":3}' | jq 'keys'\r\n"]
[22.712505, "o", "\u001b[1;39m[\r\n  \u001b[0;32m\"a\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"m\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0;32m\"z\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[23.714093, "o", "\r\n$ echo '{\"z\":1,\"a\":2,\"m\":3}' | _opam/bin/query-json 'keys'\r\n"]
[23.720158, "o", "[ \u001b[32m\"z\"\u001b[39m\u001b[0m, \u001b[32m\"a\"\u001b[39m\u001b[0m, \u001b[32m\"m\"\u001b[39m\u001b[0m ]\r\n"]
[25.723174, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/07-unique-insertion-order.sh\r\n"]
[25.725006, "o", "\r\n# unique insertion order\r\n"]
[26.525996, "o", "\r\n$ echo '[3,1,2,1,3]' | jq 'unique'\r\n"]
[26.528298, "o", "\u001b[1;39m[\r\n  \u001b[0;39m1\u001b[0m\u001b[1;39m,\r\n  \u001b[0;39m2\u001b[0m\u001b[1;39m,\r\n  \u001b[0;39m3\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[27.529992, "o", "\r\n$ echo '[3,1,2,1,3]' | _opam/bin/query-json 'unique'\r\n"]
[27.535318, "o", "[ \u001b[32m3\u001b[39m\u001b[0m, \u001b[32m1\u001b[39m\u001b[0m, \u001b[32m2\u001b[39m\u001b[0m ]\r\n"]
[29.538363, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/08-infinite-generator.sh\r\n"]
[29.540447, "o", "\r\n# infinite generator\r\n"]
[30.341497, "o", "\r\n$ _opam/bin/query-json '[limit(5; infinite)]' <<< 'null'\r\n"]
[30.347138, "o", "[ \u001b[32m0\u001b[39m\u001b[0m, \u001b[32m1\u001b[39m\u001b[0m, \u001b[32m2\u001b[39m\u001b[0m, \u001b[32m3\u001b[39m\u001b[0m, \u001b[32m4\u001b[39m\u001b[0m ]\r\n"]
[32.350184, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/09-optional-access-functions.sh\r\n"]
[32.352355, "o", "\r\n# Optional access on functions\r\n"]
[33.153356, "o", "\r\n$ _opam/bin/query-json 'first?' <<< '[]'\r\n"]
[33.159185, "o", "\u001b[32mnull\u001b[39m\u001b[0m\r\n"]
[34.161203, "o", "\r\n$ _opam/bin/query-json 'last?' <<< '[]'\r\n"]
[34.167272, "o", "\u001b[32mnull\u001b[39m\u001b[0m\r\n"]
[36.170628, "o", "\r\n$ bash docs/demo-scripts/jq-compat-demos/10-additional-features.sh\r\n"]
[36.172609, "o", "\r\n# Additional query-json features\r\n"]
[36.973633, "o", "\r\n$ _opam/bin/query-json 'pluck(.name)' <<< '[{\"name\":\"A\"},{\"name\":\"B\"}]'\r\n"]
[36.979444, "o", "[ \u001b[32m\"A\"\u001b[39m\u001b[0m, \u001b[32m\"B\"\u001b[39m\u001b[0m ]\r\n"]
[37.981379, "o", "\r\n$ _opam/bin/query-json 'partition(. > 10)' <<< '[3,12,1,20]'\r\n"]
[37.987016, "o", "[ [ \u001b[32m12\u001b[39m\u001b[0m, \u001b[32m20\u001b[39m\u001b[0m ], [ \u001b[32m3\u001b[39m\u001b[0m, \u001b[32m1\u001b[39m\u001b[0m ] ]\r\n"]
[38.989023, "o", "\r\n$ _opam/bin/query-json 'find(. > 10)' <<< '[3,12,1,20]'\r\n"]
[38.994768, "o", "\u001b[32m12\u001b[39m\u001b[0m\r\n"]
