type arity = {
  type_ : string; [@mel.as "type"]
  arg1 : string Js.Undefined.t;
  arg2 : string Js.Undefined.t;
  arg3 : string Js.Undefined.t;
}

type function_info = {
  name : string;
  aliases : string array;
  description : string;
  example : string Js.Undefined.t;
  applicableTo : string array;
  arity : arity;
}

type category = {
  name : string;
  description : string;
  functions : function_info array;
}

let get_categories : unit -> category array =
  [%mel.raw {| function () { return window['query-json'].categories(); }|}]

module CategorySection = struct
  let[@react.component] make ~category ~on_select_function =
    let is_open, set_is_open = React.useState (fun () -> false) in
    let toggle _ = set_is_open (fun prev -> not prev) in
    let functions = Array.to_list category.functions in
    <div className="border-b border-border last:border-b-0">
      <button
        onClick=toggle
        className="w-full px-4 py-3 flex items-center justify-between \
                   hover:bg-accent/50 transition-colors cursor-pointer \
                   text-left">
        <div className="flex flex-col gap-0.5">
          <span className="text-sm font-medium text-foreground capitalize">
            (React.string category.name)
          </span>
          <span className="text-xs text-muted-foreground">
            (React.string
               (string_of_int (List.length functions) ^ " functions"))
          </span>
        </div>
        (if is_open then <Icons.ChevronDown size=Small />
         else <Icons.ChevronRight size=Small />)
      </button>
      (if is_open then
         <div className="pb-2">
           (functions
           |> List.map (fun (fn : function_info) ->
               let example_text =
                 match Js.Undefined.toOption fn.example with
                 | Some ex -> ex
                 | None -> ""
               in
               <button
                 key=fn.name
                 onClick=(fun _ -> on_select_function fn.name)
                 className="w-full px-4 py-2 text-left hover:bg-accent/30 \
                            transition-colors cursor-pointer group">
                 <div className="flex flex-col gap-1">
                   <code
                     className="text-xs font-mono text-foreground \
                                group-hover:text-accent-foreground">
                     (React.string fn.name)
                   </code>
                   <span className="text-xs text-muted-foreground line-clamp-2">
                     (React.string fn.description)
                   </span>
                   (if example_text <> "" then
                      <code
                        className="text-xs font-mono text-muted-foreground/70 \
                                   truncate block">
                        (React.string example_text)
                      </code>
                    else React.null)
                 </div>
               </button>)
           |> Array.of_list |> React.array)
         </div>
       else React.null)
    </div>
end

let[@react.component] make ~is_open ~on_close ~on_select_function =
  if not is_open then React.null
  else
    <div
      className="fixed inset-y-0 left-0 z-40 w-96 bg-card border-r \
                 border-border shadow-lg flex flex-col animate-in \
                 slide-in-from-left">
      <div
        className="px-4 py-4 border-b border-border flex items-center \
                   justify-between">
        <div>
          <h2 className="text-lg font-semibold text-foreground">
            (React.string "Functions")
          </h2>
          <p className="text-xs text-muted-foreground">
            (React.string "Available jq functions")
          </p>
        </div>
        <button
          onClick=(fun _ -> on_close ())
          className="p-2 text-muted-foreground hover:text-foreground \
                     hover:bg-accent rounded transition-colors cursor-pointer"
          ariaLabel="Close sidebar">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <div className="flex-1 overflow-y-auto">
        (get_categories () |> Array.to_list
        |> List.map (fun category ->
            <CategorySection key=category.name category on_select_function />)
        |> Array.of_list |> React.array)
      </div>
    </div>
